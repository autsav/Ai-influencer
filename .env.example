# ─────────────────────────────────────────────
# fal.ai
# ─────────────────────────────────────────────
FAL_KEY=your_fal_api_key

# ─────────────────────────────────────────────
# Supabase (free tier)
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ─────────────────────────────────────────────
# Cloudflare R2
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=ig-media
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# ─────────────────────────────────────────────
# Meta Graph API
# ─────────────────────────────────────────────
IG_USER_ID=your_instagram_user_id
META_LONG_LIVED_TOKEN=your_60_day_token
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
GRAPH_VERSION=v23.0

# ─────────────────────────────────────────────
# Anthropic
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key

# ─────────────────────────────────────────────
# Security — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use this as the Bearer token in all /trigger/* calls.
# ─────────────────────────────────────────────
API_SECRET_KEY=your_generated_64_char_hex_secret

# ─────────────────────────────────────────────
# Telegram alerts (optional but strongly recommended)
# 1. Create bot via @BotFather → copy token
# 2. Add bot to group → GET /getUpdates → copy chat.id
# Leave empty to disable alerts silently.
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# Trained Aeloria LoRA (output of scripts/train_lora.py)
# ─────────────────────────────────────────────
AELORIA_LORA_URL=

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
APP_ENV=production
CHARACTER_ID=your_character_uuid
